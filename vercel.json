{
    "version": 2,
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/api"
        }
    ],
    "crons": [
        {
            "path": "/api/cron/vaccination-reminders",
            "schedule": "0 0 * * *"
        },
        {
            "path": "/api/cron/foster-update-reminders",
            "schedule": "0 1 * * *"
        }
    ]
}